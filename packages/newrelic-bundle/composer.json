{
    "name": "codraw/newrelic-bundle",
    "description": "Integrate New Relic monitoring into Symfony",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "draw",
        "bundle",
        "symfony"
    ],
    "authors": [
        {
            "name": "Martin Poirier Theoret",
            "email": "mpoiriert@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "monolog/monolog": "^3.5.0",
        "psr/log": "^3",
        "symfony/config": "^7.4.0",
        "symfony/console": "^7.4.0",
        "symfony/dependency-injection": "^7.4.0",
        "symfony/event-dispatcher": "^7.4.0",
        "symfony/http-foundation": "^7.4.0",
        "symfony/http-kernel": "^7.4.0"
    },
    "require-dev": {
        "matthiasnoback/symfony-dependency-injection-test": "^6.3",
        "phpunit/phpunit": "^12.5",
        "symfony/framework-bundle": "^7.4.0",
        "symfony/monolog-bundle": "^3.7",
        "symfony/routing": "^7.4.0",
        "twig/twig": "^3.0"
    },
    "suggest": {
        "symfony/monolog-bundle": "To forward Monolog records to New Relic",
        "twig/twig": "To render the browser timing header and footer from a template"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Draw\\Bundle\\NewRelicBundle\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.38-dev"
        }
    }
}
