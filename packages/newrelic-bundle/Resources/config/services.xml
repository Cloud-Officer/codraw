<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults autowire="true" autoconfigure="true" public="false" />
        <prototype namespace="Draw\Bundle\NewRelicBundle\Command\" resource="../../Command/*" />
        <prototype namespace="Draw\Bundle\NewRelicBundle\NewRelic\" resource="../../NewRelic/*" />
        <prototype namespace="Draw\Bundle\NewRelicBundle\TransactionNamingStrategy\" resource="../../TransactionNamingStrategy/*" />

        <service id="Draw\Bundle\NewRelicBundle\NewRelic\AdaptiveInteractor">
            <argument type="service" id="Draw\Bundle\NewRelicBundle\NewRelic\NewRelicInteractor" />
            <argument type="service" id="Draw\Bundle\NewRelicBundle\NewRelic\BlackholeInteractor" />
        </service>
    </services>
</container>
