{
    "name": "codraw/sonata-integration-bundle",
    "description": "Integrate compatible draw packages in Sonata admin",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "sonata"
    ],
    "require": {
        "php": ">=8.5",
        "codraw/framework-extra-bundle": "^0.40",
        "codraw/sonata-extra-bundle": "^0.40",
        "symfony/framework-bundle": "^7.4.0",
        "symfony/expression-language": "^7.4.0",
        "sonata-project/admin-bundle": "^4.8",
        "sonata-project/doctrine-orm-admin-bundle": "^4.2"
    },
    "require-dev": {
        "codraw/application": "^0.40",
        "codraw/console": "^0.40",
        "codraw/messenger": "^0.40",
        "codraw/security": "^0.40",
        "codraw/tester": "^0.40",
        "codraw/user-bundle": "^0.40",
        "firebase/php-jwt": "^6.1",
        "phpunit/phpunit": "^12.5",
        "scheb/2fa-bundle": "^7.6",
        "scheb/2fa-email": "^7.6",
        "endroid/qr-code": "^6.0",
        "scheb/2fa-totp": "^7.6"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Draw\\Bundle\\SonataIntegrationBundle\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.38-dev"
        }
    },
    "replace": {
        "draw/sonata-integration-bundle": "self.version"
    }
}
